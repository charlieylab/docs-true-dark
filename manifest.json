{
  "manifest_version": 3,
  "name": "Docs True Dark",
  "version": "0.3.1",
  "description": "Google Docs 深色模式：重新上色文字與背景，圖片保持原始像素；圖片可一鍵複製到其他軟體或下載。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.googleusercontent.com/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Docs True Dark",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "page-hook.js",
        "image-saver.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "ui.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://docs.google.com/*",
        "https://contacts.google.com/widget/*"
      ],
      "exclude_matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
